<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR 코드 생성기</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body class="container mt-5">
    <h1 class="text-center">QR 코드 생성기</h1>
    <form action="/generate" method="POST" class="mt-r">
        <div class="mb-3">
            <input type="text" name="text" class="form-control" placeholder="텍스트 또는 URL 입력" required>
        </div>
        <button type="submit" class="btn btn-primary w-100">QR 코드 생성</button>
    </form> 
    
    <% if (qrCodeURL) { %>
        <div class="text-center mt-4">
            <h3>생성된 QR 코드</h3>
            <img src="<%= qrCodeURL %>" alt="QR 코드" class="img-fluid">
            <a href="<%= qrCodeURL %>" download="qrcode.png" class="btn btn-primary mt-3">QR 코드 다운로드</a>
        </div>
    <% } %>
</body>
</html>